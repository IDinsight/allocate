
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────

enum Role {
  DS
  DE
  FSE
  PM
}

enum Level {
  INT
  I
  II
  III
  IV
  AD
  D
}

enum Region {
  Global
  IND
  WNA
  ESA
  SEA
}

enum TeammateStatus {
  Active
  Alumni
}

enum Pillar {
  Products
  Services
  Advisory
  Admin
}

enum BillingRate {
  Internal
  L1
  Fractional
  CoImpact
  Standard
}

enum ProjectStatus {
  Upcoming
  Active
  Paused
  Archived
  Completed
}

// ─── Models ───────────────────────────────────────────────

model Teammate {
  id     String         @id @default(cuid())
  name   String
  email  String?        @unique
  role   Role?
  level  Level?
  region Region?
  status TeammateStatus @default(Active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledProjects Project[]
  allocations Allocation[]

  @@index([status])
  @@map("teammates")
}

model Project {
  id                    String        @id @default(cuid())
  name                  String
  pillar                Pillar?
  region                Region?
  billingRate           BillingRate?
  status                ProjectStatus @default(Upcoming)
  conversionProbability Int?
  billable              Boolean       @default(false)
  unit4Code             String?
  startDate             DateTime?     @db.Date
  endDate               DateTime?     @db.Date
  blurb                 String?

  leadId String?
  lead   Teammate? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations Allocation[]

  @@index([status])
  @@index([leadId])
  @@map("projects")
}

model Allocation {
  id         String   @id @default(cuid())
  teammateId String
  projectId  String
  weekStart  DateTime @db.Date
  fraction   Int
  isHidden   Boolean  @default(false)

  teammate Teammate @relation(fields: [teammateId], references: [id], onDelete: Restrict)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teammateId, projectId, weekStart])
  @@index([teammateId])
  @@index([projectId])
  @@index([weekStart])
  @@map("allocations")
}

model Notepad {
  id        String   @id @default("singleton")
  content   String   @default("")
  updatedAt DateTime @updatedAt

  @@map("notepad")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Append-only login history. Better Auth's `session` rows are deleted on
// sign-out and expiry, so they record who is signed in now, not who has ever
// signed in. Email and name are copied in rather than joined so the history
// stays readable after a user row is deleted.
model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  email     String
  name      String?
  access    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@map("login_log")
}

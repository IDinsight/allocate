# Supabase Postgres connection strings (find in Supabase dashboard > Settings > Database)
# Connect to Supabase via connection pooling.
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection to the database. Used for migrations.
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Google OAuth (Google Cloud console > APIs & Services > Credentials).
# Authorised redirect URI for each deployment: <origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Emails allowed to sign in even without a teammate record (comma-separated).
# Needed for the first login on an empty database — otherwise nobody can get in.
EXTRA_ALLOWED_EMAILS=

# Read-only API keys (comma-separated, optional). Grant GET-only access to
# /api/* via `Authorization: Bearer <key>` (or `x-api-key: <key>`).
# Generate with: openssl rand -hex 24
READONLY_API_KEYS=

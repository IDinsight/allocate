# Supabase Postgres connection strings (find in Supabase dashboard > Settings > Database)
# Connect to Supabase via connection pooling.
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection to the database. Used for migrations.
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Google OAuth (Google Cloud console > APIs & Services > Credentials).
# Authorised redirect URI for each deployment: <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Better Auth. Generate the secret with: openssl rand -base64 32
# The URL is optional — this deployment's public origin. Without it the origin
# is inferred from the request, which is wrong behind a proxy that rewrites it.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email domains allowed to sign in (comma-separated). Anyone on one of these
# domains may sign in read-only; teammates additionally get edit access.
# Defaults to idinsight.org when unset.
ALLOWED_EMAIL_DOMAINS=idinsight.org

# Emails granted edit access without a teammate record (comma-separated).
# Needed for the first login on an empty database — otherwise nobody can edit.
EXTRA_ALLOWED_EMAILS=

# Read-only API keys (comma-separated, optional). Grant GET-only access to
# /api/* via `Authorization: Bearer <key>` (or `x-api-key: <key>`).
# Generate with: openssl rand -hex 24
READONLY_API_KEYS=
